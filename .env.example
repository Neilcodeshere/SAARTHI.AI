# SAARTHI.AI server-side configuration. Copy to .env and fill in; .env is git-ignored.
# These are read only by the Vite dev/preview server middleware (server/), never by the browser.
# Do NOT prefix them with VITE_ — that would expose them to the client bundle.

# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model ID. Default: openai/gpt-oss-120b (production model with strict JSON-schema output).
# Check https://console.groq.com/docs/models before changing.
GROQ_MODEL=openai/gpt-oss-120b

# Request timeout in milliseconds (optional).
GROQ_TIMEOUT_MS=20000
